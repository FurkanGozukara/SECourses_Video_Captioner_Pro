{
  "_meta": {
    "format": "secourses_vcap_preset",
    "version": 1,
    "name": "Wan 2.2 T2V dataset (TimeChat flatten)",
    "description": "TimeChat native timestamped analysis flattened to detailed events and camera motion for Wan training."
  },
  "settings": {
    "model_key": "timechat_int8",
    "prompt_preset_id": "timechat_flatten_wan",
    "system_prompt": null,
    "user_prompt": "Thoroughly describe everything in the video, capturing every detail. Include as much information from the audio as possible, and ensure that the descriptions of both audio and video are well-coordinated.",
    "trigger_word": "ohwx",
    "language": "English",
    "source_language": "English",
    "target_language": "English",
    "caption_length": "detailed",
    "avoid_list": "",
    "temperature": 0.0,
    "top_p": 1.0,
    "top_k": 1,
    "repetition_penalty": 1.0,
    "max_new_tokens": 9216,
    "do_sample": false,
    "fps": 2.0,
    "max_frames": 160,
    "max_pixels": 297920,
    "min_pixels": 65536,
    "use_audio_in_video": true,
    "scene_detect_enabled": true,
    "scene_threshold": 27.0,
    "scene_min_len_s": 2.0,
    "scene_max_len_s": 60.0,
    "merge_short_scenes": true,
    "split_mode": "copy",
    "max_clip_duration_s": 60.0,
    "sub_split_overlap_s": 0.5,
    "caption_prefix": "",
    "caption_suffix": "",
    "trigger_mode": "none",
    "replace_words": "",
    "output_formats": ["txt", "json", "srt"],
    "save_clips": true,
    "save_reasoning": true,
    "overwrite_existing": false,
    "vram_preset": "auto",
    "attention_backend": "auto",
    "subprocess_mode": true,
    "keep_model_loaded": true,
    "idle_unload_minutes": 10
  }
}
