{
  "_meta": {
    "format": "secourses_vcap_preset",
    "version": 1,
    "name": "Audio SFX captions (Qwen3 Captioner)",
    "description": "Prompt-free, maximum-detail audio captions from the dedicated Qwen3-Omni Captioner model."
  },
  "settings": {
    "model_key": "qwen3_omni_captioner_int8",
    "prompt_preset_id": "qwen3_captioner_promptfree",
    "system_prompt": null,
    "user_prompt": "",
    "trigger_word": "ohwx",
    "language": "English",
    "source_language": "English",
    "target_language": "English",
    "caption_length": "detailed",
    "avoid_list": "",
    "temperature": 0.6,
    "top_p": 0.95,
    "top_k": 20,
    "repetition_penalty": 1.0,
    "max_new_tokens": 8192,
    "do_sample": true,
    "fps": 1.0,
    "max_frames": 0,
    "max_pixels": 262144,
    "min_pixels": 65536,
    "use_audio_in_video": true,
    "scene_detect_enabled": false,
    "scene_threshold": 27.0,
    "scene_min_len_s": 2.0,
    "scene_max_len_s": 30.0,
    "merge_short_scenes": true,
    "split_mode": "precise",
    "max_clip_duration_s": 30.0,
    "sub_split_overlap_s": 0.0,
    "caption_prefix": "",
    "caption_suffix": "",
    "replace_words": "",
    "output_formats": ["txt", "json"],
    "save_clips": false,
    "save_reasoning": false,
    "overwrite_existing": false,
    "vram_preset": "auto",
    "attention_backend": "auto",
    "subprocess_mode": true,
    "keep_model_loaded": true,
    "idle_unload_minutes": 10
  }
}
